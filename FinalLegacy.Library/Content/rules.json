    "baseArmorClass": 10,
    "proficiency": 2,
    "mediumArmorAgilityCap": 2,
    "fleeDifficulty": 12
  },

  // The original classes and stats (2023). "armor" is the heaviest armour the class is trained in; the two kits
  // are the original weapon choices, now with the rest of the gear that comes with them.
  "classes": [
    {
      "id": "warrior",
      "color": "crimson",
      "hair": "#6b4423",
      "hp": 34,
      "stats": { "attack": 4, "defense": 5, "agility": 2, "intelligence": 2 },
      "armor": "heavy",
      "shields": true,
      "kits": [
        { "show": "doransShield", "items": [ "doransShield", "ironSword", "chainShirt" ] },
        { "show": "arturiasSword", "items": [ "arturiasSword", "chainShirt" ] }
      ]
    },
    {
      "id": "mage",
      "color": "cyan",
      "hair": "#c9ccd6",
