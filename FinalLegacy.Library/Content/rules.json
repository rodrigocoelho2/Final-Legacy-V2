  // The three enemies of chapter I. "aggression" is the chance they attack in a round (otherwise they guard and you
  // attack with disadvantage).
  // Loot: gold in a range; "drops" are each rolled on their own (an enemy's signature item); then "rolls" times a
  // rarity is drawn by its weight ("none" = nothing) and a random item of that rarity drops.
  "enemies": [
    {
      "id": "skeleton",
      "hp": 13,
      "ac": 13,
      "hit": 3,
      "damage": "1d6+1",
      "type": "slashing",
      "agility": 2,
      "aggression": 0.6,
      "loot": {
        "gold": [ 5, 10 ],
        "drops": [ { "item": "potion", "chance": 0.5 } ],
        "rolls": 2,
        "rarity": { "none": 30, "common": 48, "uncommon": 18, "rare": 4 }
      }
    },
    {
      "id": "shadow",
      "hp": 20,
      "ac": 13,
      "hit": 4,
      "damage": "1d8+2",
      "type": "necrotic",
      "agility": 5,
      "aggression": 0.7,
      "loot": {
        "gold": [ 15, 25 ],
        "drops": [ { "item": "shadowCloak", "chance": 0.5 } ],
        "rolls": 2,
        "rarity": { "none": 5, "common": 15, "uncommon": 35, "rare": 30, "epic": 12, "legendary": 3 }
      }
    },
    {
      "id": "golem",
      "hp": 26,
